@model IEnumerable<Post>
@using Website.Services
@{
    ViewData["Title"] = "Clint McMahon | Freelance Software Developer in Minneapolis, MN";
    ViewData["Description"] = "Freelance software developer and architect in Minneapolis, MN. 20+ years of .NET, C# and Azure work building data platforms and modernizing legacy systems. Available for projects and retainers.";
}

@* Person + ProfessionalService for local search. The @@id values are shared with
   the schema block on /freelance-developer-minneapolis so Google treats them as
   the same entity rather than two unrelated ones. *@
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "Person",
      "@@id": "https://clintmcmahon.com/#person",
      "name": "Clint McMahon",
      "jobTitle": "Freelance Software Developer and Architect",
      "url": "https://clintmcmahon.com",
      "image": "https://clintmcmahon.com/images/icon/me.jpg",
      "email": "clintmcmahon@@pm.me",
      "telephone": "+1-612-314-5384",
      "worksFor": {
        "@@type": "ProfessionalService",
        "@@id": "https://parkasoftware.com/#organization",
        "name": "Parka Software",
        "url": "https://parkasoftware.com"
      },
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "Minneapolis",
        "addressRegion": "MN",
        "addressCountry": "US"
      },
      "knowsAbout": [".NET", "C#", "ASP.NET Core", "Umbraco CMS", "Azure", "React", "SQL Server", "Data Visualization"],
      "sameAs": [
        "https://www.linkedin.com/in/clintmcmahon/",
        "https://github.com/clintmcmahon",
        "https://indieweb.social/@@clint",
        "https://www.instagram.com/cwmcmhn/"
      ]
    },
    {
      "@@type": "ProfessionalService",
      "@@id": "https://clintmcmahon.com/#business",
      "name": "Clint McMahon",
      "description": "Independent freelance developer in Minneapolis with 20+ years of experience specializing in .NET, Umbraco, custom web applications, data integrations and legacy system modernization.",
      "url": "https://clintmcmahon.com/freelance-developer-minneapolis",
      "founder": { "@@id": "https://clintmcmahon.com/#person" },
      "knowsAbout": [".NET", "C#", "Umbraco CMS", "Azure", "Legacy System Modernization", "Data Integration"],
      "sameAs": [
        "https://www.linkedin.com/in/clintmcmahon/",
        "https://github.com/clintmcmahon"
      ],
      "telephone": "+1-612-314-5384",
      "image": "https://clintmcmahon.com/images/icon/me.jpg",
      "priceRange": "$$$",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "Minneapolis",
        "addressRegion": "MN",
        "addressCountry": "US"
      },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": 44.9778,
        "longitude": -93.2650
      },
      "areaServed": [
        { "@@type": "City", "name": "Minneapolis" },
        { "@@type": "City", "name": "Saint Paul" },
        { "@@type": "State", "name": "Minnesota" },
        { "@@type": "Country", "name": "United States" }
      ]
    },
    {
      "@@type": "WebSite",
      "@@id": "https://clintmcmahon.com/#website",
      "url": "https://clintmcmahon.com",
      "name": "Clint McMahon",
      "publisher": { "@@id": "https://clintmcmahon.com/#person" }
    }
  ]
}
</script>

<div class="home">

    <section class="home-intro">
        <div>
            <p class="home-label">Clint McMahon / Minneapolis, MN</p>
            <h1 class="home-title">I build things for<br>the Internet.</h1>
            <p class="home-lead">
                Welcome to my website. I live in Minneapolis, MN where I run <a target="_blank" href="https://parkasoftware.com">Parka Software</a> - a software consulting company. This is where I write down what I'm learning, building and making.
            </p>
        </div>
        <img class="home-portrait" src="/images/icon/me.jpg" alt="Clint McMahon" width="176" height="176" />
    </section>

    <div class="home-body">
        <section class="h-feed">
            <h2 class="home-label">Latest posts</h2>
            <ol class="home-posts">
                @foreach (var post in Model)
                {
                    <li class="h-entry">
                        <a href="@Url.Action("Details", "Blog", new { slug = post.Slug })">
                            <span class="u-url" hidden>@CanonicalUrlHelper.BlogPost(post.Slug)</span>
                            <time class="dt-published" datetime="@post.Date.ToString("yyyy-MM-dd")">@post.Date.ToString("MMM d")</time>
                            <div>
                                <h3 class="p-name">@post.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(post.Description))
                                {
                                    <p class="p-summary">@post.Description</p>
                                }
                            </div>
                        </a>
                    </li>
                }
            </ol>
            <a class="home-all" href="/blog">All posts &rarr;</a>
        </section>

        <aside class="home-index" aria-label="Around the site">
            <h2 class="home-label">Around the site</h2>
            <ul>
                <li><a href="/about"><strong>About</strong><span>Who I am and where to find me</span></a></li>
                <li><a href="/now"><strong>Now</strong><span>What I'm working on and thinking about</span></a></li>
                <li><a href="/projects"><strong>Projects</strong><span>Coffee maps, a radio archive, weather records</span></a></li>
                <li><a href="/photo"><strong>Photo</strong><span>The latest from my photoblog</span></a></li>
                <li><a href="/tools"><strong>Tools</strong><span>Small utilities that run in your browser</span></a></li>
                <li><a href="/feeds"><strong>Blogroll</strong><span>The blogs I read</span></a></li>
                <li><a href="/guestbook"><strong>Guestbook</strong><span>Leave a note</span></a></li>
                <li><a href="/contact"><strong>Contact</strong><span>Email me</span></a></li>
                <li><a href="https://parkasoftware.com"><strong>Parka Software &nearr;</strong><span>My consulting company</span></a></li>
            </ul>

            @if (!string.IsNullOrWhiteSpace(NowStatus.Blurb) || !string.IsNullOrWhiteSpace(NowStatus.CurrentlyBrewing))
            {
                <dl class="home-now">
                    @if (!string.IsNullOrWhiteSpace(NowStatus.Blurb))
                    {
                        <div>
                            <dt>Now</dt>
                            <dd>@NowStatus.Blurb</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(NowStatus.CurrentlyBrewing))
                    {
                        <div>
                            <dt>Brewing</dt>
                            <dd>@NowStatus.CurrentlyBrewing</dd>
                        </div>
                    }
                </dl>
            }
        </aside>
    </div>
</div>
