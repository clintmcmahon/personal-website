@{
    ViewData["Title"] = "Contact a Freelance Developer in Minneapolis | Clint McMahon";
    ViewData["Description"] = "Get in touch about a stalled project, a new build, or a technology initiative that needs rescuing. Freelance developer based in Minneapolis, MN. I read and respond to every message myself.";
}

<section class="contact py-5">
  <div class="container" style="max-width:800px">
    <h1 class="display-4 fw-bold text-center mb-3">Let's Talk</h1>
    <p class="lead text-center mb-4">Drop me a line if you have something to say, comment or just want to see what's going on. Happy to just say hi, or take a good coffee recommendation.</p>

    <div class="row g-4">
    <div class="col">
    @Html.Partial("_Contact")
</div>
    </div>
  </div>
</section>
