@model List<Website.Models.ToolEntry>
@{
  ViewData["Title"] = "Tools | Clint McMahon";
}
<section class="tools py-5">
  <div class="container">
    <h1 class="text-center mb-4">Tools</h1>
    <div class="row mb-5">
      <div class="col-lg-8 mx-auto text-center">
        <p class="lead">Small single-purpose utilities that run entirely in your browser. No sign-up, no tracking, nothing sent to a server.</p>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-8 mx-auto">
        @if (!Model.Any())
        {
          <p class="text-center text-muted">Nothing here yet &mdash; check back soon.</p>
        }
        else
        {
          @foreach (var tool in Model)
          {
            <div class="row align-items-center mb-4 pb-4 border-bottom">
              <div class="col-12">
                <h2 class="h4"><a href="/tools/@tool.Slug">@tool.Title</a></h2>
                <p class="mb-1">@tool.Description</p>
                <small class="text-muted">@tool.Date.ToString("MMMM d, yyyy")</small>
              </div>
            </div>
          }
        }
      </div>
    </div>
  </div>
</section>
