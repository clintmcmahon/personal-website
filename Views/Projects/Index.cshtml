@model List<List<Website.Models.Project>>
@{
  ViewData["Title"] = "Projects | Clint McMahon";
  ViewData["Description"] = "Side projects born from curiosity, creativity and the drive to build something useful: coffee maps, weather data, music archives, and more.";
}

<div class="page-intro">
    <h1>Projects</h1>
    <p>A collection of side projects born from curiosity, creativity and the drive to build something useful.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="text-muted small mt-2"><a href="/admin/projects">Edit projects</a></p>
    }
</div>

@for (var i = 0; i < Model.Count; i++)
{
    var cards = Model[i];
    var isLast = i == Model.Count - 1;

    <span class="portfolio-section-label" style="@(i == 0 ? "margin-top:0" : "")">@cards[0].Section</span>
    <div class="portfolio-grid" style="@(isLast ? "margin-bottom: 4rem;" : "")">
        @foreach (var p in cards)
        {
            <a href="@p.Url" class="portfolio-card">
                <div class="project-card-icon-wrap">
                    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" class="project-card-icon" alt="@p.Name">
                    }
                    else
                    {
                        <div class="project-card-icon project-card-icon-glyph"><i class="bi @(p.IconClass ?? "bi-box")"></i></div>
                    }
                </div>
                <div class="portfolio-card-body">
                    <h2 class="portfolio-card-title">@p.Name</h2>
                    <p class="portfolio-card-text">@p.Description</p>
                    @if (p.TechList.Any())
                    {
                        <div class="card-tech">
                            @foreach (var t in p.TechList)
                            {
                                <span>@t</span>
                            }
                        </div>
                    }
                </div>
            </a>
        }
    </div>
}
