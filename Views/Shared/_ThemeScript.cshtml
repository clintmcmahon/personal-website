@* Inlined in <head> by both layouts, ahead of the stylesheets, so the theme is set
   before first paint and there's no flash of the wrong palette.

   The theme follows the visitor's OS light/dark setting, live. The toggle button
   saves a manual choice. Toggling back to whatever the OS is set to clears that
   choice, so the site goes back to following the OS. *@
<script>
(function () {
    var KEY = "theme";
    var root = document.documentElement;
    var os = window.matchMedia("(prefers-color-scheme: dark)");

    function osTheme() { return os.matches ? "dark" : "light"; }

    // Storage can be blocked (private windows, strict settings). The OS setting still works.
    function saved() {
        try {
            var t = localStorage.getItem(KEY);
            return t === "light" || t === "dark" ? t : null;
        } catch (e) { return null; }
    }

    function current() { return saved() || osTheme(); }

    function label(theme) {
        var next = theme === "dark" ? "light" : "dark";
        document.querySelectorAll("[data-theme-toggle]").forEach(function (b) {
            b.setAttribute("aria-label", "Switch to " + next + " mode");
            b.title = "Switch to " + next + " mode";
        });
    }

    function apply(theme) {
        root.setAttribute("data-theme", theme);
        label(theme);
    }

    function toggle() {
        var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        try {
            if (next === osTheme()) localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, next);
        } catch (e) { }
        apply(next);
    }

    // Leftover from the short-lived time-of-day version.
    try { localStorage.removeItem("theme-override"); } catch (e) { }

    apply(current());

    // Follow the OS live (e.g. macOS switching at sunset) unless a choice is saved.
    os.addEventListener("change", function () { apply(current()); });

    document.addEventListener("DOMContentLoaded", function () {
        label(root.getAttribute("data-theme"));
        document.querySelectorAll("[data-theme-toggle]").forEach(function (b) {
            b.addEventListener("click", toggle);
        });
    });
})();
</script>
