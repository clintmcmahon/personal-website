@model IEnumerable<Website.Models.BlogComment>
@{
    var slug = ViewData["BlogSlug"] as string;
}
<div class="blog-comments mt-5">
    <h3>Comments</h3>
    @if (!Model.Any())
    {
        <p>No comments yet. Be the first to comment!</p>
    }
    else
    {
        <ul class="list-unstyled">
        @foreach (var comment in Model)
        {
            <li class="mb-3">
                <strong>@comment.Name</strong> <span class="text-muted">(@comment.CreatedAt.ToLocalTime().ToString("g"))</span><br />
                @comment.Content
            </li>
        }
        </ul>
    }
    <form asp-controller="BlogComments" asp-action="Post" method="post" class="mt-3">
        <input type="hidden" name="slug" value="@slug" />
        <input type="hidden" name="loadedAt" value="@DateTimeOffset.UtcNow.ToUnixTimeSeconds()" />
        <div class="hp-field" aria-hidden="true">
            <label>Leave this field blank</label>
            <input type="text" name="hp_website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="mb-2">
            <input type="text" name="name" class="form-control" placeholder="Your name" required />
        </div>
        <div class="mb-2">
            <textarea name="content" class="form-control" placeholder="Your comment" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Post Comment</button>
    </form>
</div>
