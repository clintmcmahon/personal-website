@model Post
@{
    var subject = Uri.EscapeDataString($"Re: {Model.Title}");
}
<div class="reply-by-email mt-5 pt-4 border-top">
    <p class="text-muted mb-0">
        This blog doesn't have a comments section. If you've got thoughts on this post, <a href="mailto:clintmcmahon@pm.me?subject=@subject">reply by email</a> — I read everything that comes in.
    </p>
</div>
